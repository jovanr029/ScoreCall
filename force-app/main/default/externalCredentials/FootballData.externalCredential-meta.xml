<?xml version="1.0" encoding="UTF-8" ?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>football-data.org API key. Sends it as the X-Auth-Token header. The key itself is NOT in source: enter it per org in Setup (Principals > FootballDataPrincipal > Authentication Parameters > ApiKey).</description>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>X-Auth-Token</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.FootballData.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>FootballDataPrincipal</parameterGroup>
        <parameterName>FootballDataPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Football Data</label>
</ExternalCredential>
