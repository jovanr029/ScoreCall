<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Teams_Must_Differ</fullName>
    <active>true</active>
    <description>A team can't play against itself.</description>
    <errorConditionFormula>Home_Team__c = Away_Team__c</errorConditionFormula>
    <errorDisplayField>Away_Team__c</errorDisplayField>
    <errorMessage>Home and away team must be different.</errorMessage>
</ValidationRule>
